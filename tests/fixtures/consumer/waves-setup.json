{
 "about": "Pinned consumer setup for the #26 waveform registry (T11): TinyChip and Beast chip waves in the consumer's WaveDef form and converted per D-006, with presets and drum overrides that use them. Install order (contracts.md, consumer setup contract): construct, setQuality(settings.quality), setMasterVol, setReverbLev, setVoices, register every wave in order, then setTimbre for each timbre. The registered names stand for the consumer's Waveform::Custom(index), index = position in waves.",
 "provenance": {
  "consumer": {
   "repo": "Provable-Games/onchain-tinysynth",
   "path": "/workspace/onchain-tinysynth",
   "commit": "d7357936754b5753ee4e9cc9134a0d373b75c099",
   "files": {
    "src/types.cairo": "7965e1730fb5458c91d277613069f60541c96ac16bf0894016522a04b372e6ce",
    "player/settings.js": "20fd90af5652d50880ba8b929f8e568b24095b77db631147d6bd9b39e6112d1d",
    "README.md": "6cf8409b9e7943067dac785fceb27da438adda8618d12335f804a28ba81a4fcc"
   }
  },
  "tinychip": {
   "repo": "midi_fun_contract",
   "commit": "b16c8ef3f0c8cc0ed252497eb2f21b91aea03389",
   "files": {
    "offchain/beast-sound/onchain/tinychip/tinychip.js": "5be0bdb8284782da5381aff8ff8e9c36328b687ee39ca04eaf59b7a086f9ce39",
    "offchain/beast-sound/onchain/dist/tinychip.min.js": "dea09707fa9f76eb49704f4992f29f78268b81fac3aaf2a5942239bcc14493ae"
   },
   "note": "presets and drums are TinyChip's BANK from dist/tinychip.min.js; waveforms follow tinychip.js registerWaves()"
  },
  "beast": {
   "repo": "midi_fun_contract",
   "commit": "b16c8ef3f0c8cc0ed252497eb2f21b91aea03389",
   "files": {
    "web/beast_sound/chip.js": "df9e8c61545b44562a0668156310de117a93e5e17e6eb0f87e3b9861d0ac12d7"
   }
  },
  "generator": "_evidence/t11-waveforms/scratch/make-waves-setup.cjs",
  "schemaNote": "nNOI (32,767 samples) is not representable at the pinned consumer commit (WaveDef::Samples is 2..=256, MAX_SAMPLES = 256); it relies on the consumer mirroring D-028. Every other wave is within the consumer's limits (8 to 93 samples, 8 and 15 harmonics, 13 waves <= 16)."
 },
 "conversion": {
  "Samples": "i8 s -> s/128 (D-006: -128 -> -1.0, 0 -> 0, 127 -> 0.9921875); float shapes are quantized to i8 with Math.round(v * 128)",
  "Harmonics": "u16 element i is harmonic i+1: imag = [0, h0/S, h1/S, ...], real = zeros, S = 10000 (any positive S gives the same normalized wave)",
  "noiseRetuning": "TinyChip played nMET/nNOI one table sample per frame at the 440 Hz basis, so its noise depended on the device sample rate. Under #26 a table's f is its cycle frequency: f = f_old * R / (440 * N) keeps TinyChip's step rate at rate R. Retuned for R = 48000 (operators); tinychipOperators keep the originals."
 },
 "settings": {
  "quality": 1,
  "reverb": 30,
  "master_vol": 40,
  "voices": 64,
  "engine": {
